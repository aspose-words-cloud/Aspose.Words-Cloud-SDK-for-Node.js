    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "yargs": "^18.0.0",
    "form-data": "^4.0.4",
    "qs": "^6.14.1",
    "tough-cookie": "^4.1.4",
    "minimatch": "^5.1.6",
    "nanoid": "^3.3.8",
    "serialize-javascript": "^7.0.5",
